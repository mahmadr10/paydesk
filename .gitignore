.env
node_modules/

# Installers / large local-only binaries - never belong in a git repo
*.exe

# Build output
dist/
build/

# Uploaded ticket attachments (local dev storage - not source)
backend/uploads/*
!backend/uploads/.gitkeep

# Test/coverage artifacts
coverage/
playwright-report/
test-results/
*.log

# Local Claude Code config
.claude/

# Demo video output (upload to YouTube instead)
demo/*.webm
demo/*.mp4
demo/raw/


.env.example
backend/.env.example
frontend/.env.example
