{
  "version": 2,
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/sla-breach",
      "schedule": "0 0 * * *"
    }
  ]
}
